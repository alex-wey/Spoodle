# Backend API URL
# For local development, use localhost
# For iOS Simulator: http://localhost:3002
# For Android Emulator: http://10.0.2.2:3002
# For Physical Device: http://YOUR_COMPUTER_IP:3002
EXPO_PUBLIC_API_URL=http://localhost:3002

# Clerk Authentication
# For local development, use your test/development publishable key
# Get it from: https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here
