generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  clerkUserId String?   @unique
  firstName   String
  lastName    String
  email       String?   @unique
  phone       String?   @unique
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  imageUrl    String?
  petOwner    PetOwner? @relation("UserPetOwner")
  staff       Staff?    @relation("UserStaff")

  @@map("users")
}

model PetOwner {
  id                 String              @id @default(uuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  clinicId           String?
  userId             String              @unique(map: "pet_owners_userid_key")
  appointmentInvites AppointmentInvite[]
  appointments       Appointment[]
  bugReports         BugReport[]
  chatMessages       ChatMessage[]
  formInvites        FormInvite[]
  formSubmissions    FormSubmission[]
  clinic             Clinic?             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user               User                @relation("UserPetOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pet_owners_userid_fkey")
  pets               Pet[]
  settings           Settings?

  @@index([clinicId])
  @@index([userId], map: "pet_owners_userid_idx")
  @@map("pet_owners")
}

model Pet {
  id                  String              @id @default(uuid())
  name                String
  species             String
  biologicalSex       String?
  breed               String?
  dateOfBirth         DateTime?
  weight              Float?
  spayedNeutered      Boolean             @default(false)
  allergies           String[]
  dietaryRestrictions String[]
  imageUrl            String?
  ownerId             String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  appointmentInvites  AppointmentInvite[]
  appointments        Appointment[]
  documents           Document[]
  formInvites         FormInvite[]
  formSubmissions     FormSubmission[]
  petOwner            PetOwner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks               Task[]

  @@index([ownerId])
  @@map("pets")
}

model Document {
  id        String   @id @default(uuid())
  category  String
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model BugReport {
  id          String   @id @default(uuid())
  petOwnerId  String
  title       String
  severity    String
  category    String
  description String
  deviceInfo  String?
  appVersion  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  petOwner    PetOwner @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([petOwnerId])
  @@index([severity])
  @@index([status])
  @@map("bug_reports")
}

model ChatMessage {
  id          String   @id @default(uuid())
  petOwnerId  String
  message     String
  isFromUser  Boolean
  messageType String   @default("text")
  metadata    Json?
  createdAt   DateTime @default(now())
  petOwner    PetOwner @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([petOwnerId])
  @@map("chat_messages")
}

model Settings {
  id              String   @id @default(uuid())
  petOwnerId      String   @unique
  theme           String   @default("light")
  language        String   @default("en")
  notifications   Boolean  @default(true)
  biometricAuth   Boolean  @default(false)
  profileImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  petOwner        PetOwner @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([petOwnerId])
  @@map("settings")
}

model Clinic {
  id                 String              @id @default(uuid())
  clerkOrgId         String              @unique
  name               String
  slug               String              @unique
  address            String?
  phoneNumber        String?
  email              String?
  imageUrl           String?
  isActive           Boolean             @default(true)
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  appointmentInvites AppointmentInvite[]
  appointments       Appointment[]
  formInvites        FormInvite[]
  forms              Form[]
  petOwners          PetOwner[]

  @@index([clerkOrgId])
  @@index([slug])
  @@map("clinics")
}

model Staff {
  id                 String              @id @default(uuid())
  userId             String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  appointmentInvites AppointmentInvite[]
  appointments       Appointment[]
  user               User                @relation("UserStaff", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("staff")
}

model Task {
  id                   String    @id @default(uuid())
  petId                String
  taskType             String
  title                String
  description          String?
  scheduledDate        DateTime
  scheduledTime        String
  completed            Boolean   @default(false)
  completedAt          DateTime?
  completedBy          String?
  completedByName      String?
  notes                String?
  carePlanId           String?
  reminderId           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  recurrenceDaysOfWeek String?
  recurrenceEndDate    DateTime?
  recurrencePattern    String?
  recurrenceTimes      String?
  recurring            Boolean   @default(false)
  pet                  Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([scheduledDate])
  @@index([completed])
  @@index([taskType])
  @@index([recurring])
  @@map("tasks")
}

model Form {
  id          String           @id @default(uuid())
  tallyFormId String           @unique
  title       String
  description String?
  clinicId    String?
  isActive    Boolean          @default(true)
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]
  clinic      Clinic?          @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([tallyFormId])
  @@index([isActive])
  @@map("forms")
}

model FormSubmission {
  id              String    @id @default(uuid())
  formId          String
  tallyResponseId String    @unique
  respondentEmail String?
  respondentName  String?
  petOwnerId      String?
  petId           String?
  submissionData  Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  form            Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  pet             Pet?      @relation(fields: [petId], references: [id])
  petOwner        PetOwner? @relation(fields: [petOwnerId], references: [id])

  @@index([formId])
  @@index([tallyResponseId])
  @@index([petOwnerId])
  @@index([petId])
  @@index([createdAt])
  @@map("form_submissions")
}

model Appointment {
  id                     String            @id @default(uuid())
  externalAppointmentId  String            @unique
  eventTypeId            String
  clinicId               String
  staffId                String
  petId                  String
  petOwnerId             String
  status                 AppointmentStatus @default(CONFIRMED)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  endTime                DateTime
  startTime              DateTime
  eventDescription       String?
  eventTitle             String?
  externalAppointmentUid String            @unique
  clinic                 Clinic            @relation(fields: [clinicId], references: [id])
  pet                    Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  petOwner               PetOwner          @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)
  staff                  Staff             @relation(fields: [staffId], references: [id])

  @@index([clinicId])
  @@index([staffId])
  @@index([petId])
  @@index([petOwnerId])
  @@index([externalAppointmentId])
  @@index([externalAppointmentUid])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@map("appointments")
}

model AppointmentInvite {
  id              String   @id @default(uuid())
  eventTypeId     String
  clinicId        String
  staffId         String
  petId           String
  petOwnerId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appointmentLink String   @unique
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  petOwner        PetOwner @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)
  staff           Staff    @relation(fields: [staffId], references: [id])

  @@index([clinicId])
  @@index([staffId])
  @@index([petId])
  @@index([petOwnerId])
  @@index([appointmentLink])
  @@index([eventTypeId])
  @@map("appointment_invites")
}

model FormInvite {
  id         String   @id @default(uuid())
  formLink   String
  clinicId   String
  petId      String
  petOwnerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  formName   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  petOwner   PetOwner @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([petId])
  @@index([petOwnerId])
  @@index([formLink])
  @@map("form_invites")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
}
