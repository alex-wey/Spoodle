generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vet {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  phone          String?
  specialization String?
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
}

model PetOwner {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  pets      Pet[]
  createdAt DateTime @default(now())
}

model Pet {
  id             String          @id @default(uuid())
  name           String
  species        String
  breed          String?
  gender         String?
  weight         Float?
  dateOfBirth    DateTime?
  owner          PetOwner        @relation(fields: [ownerId], references: [id])
  ownerId        String
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  createdAt      DateTime        @default(now())
}

model Appointment {
  id              String            @id @default(uuid())
  pet             Pet               @relation(fields: [petId], references: [id])
  petId           String
  vet             Vet               @relation(fields: [vetId], references: [id])
  vetId           String
  appointmentDate DateTime
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
}

model MedicalRecord {
  id          String   @id @default(uuid())
  pet         Pet      @relation(fields: [petId], references: [id])
  petId       String
  recordType  String
  description String
  fileUrl     String?
  createdAt   DateTime @default(now())
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}
