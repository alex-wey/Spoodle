generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("MOBILE_DATABASE_URL")
}

model User {
  id          String     @id @default(uuid())
  clerkUserId String     @unique // Clerk user ID
  firstName   String
  lastName    String
  email       String     @unique
  phone       String?
  address     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // Relation to PetOwner
  petOwner    PetOwner?

  @@map("users")
}

model PetOwner {
  id             String           @id @default(uuid())
  clerkUserId    String           @unique // Foreign key to User
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  // Relations
  user           User             @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Cascade)
  bugReports     BugReport[]
  chatMessages   ChatMessage[]
  userPreference UserPreference?

  @@map("pet_owners")
}

model Pet {
  id                  String     @id @default(uuid())
  name                String
  species             String
  breed               String?
  gender              String?
  weight              Float?
  dateOfBirth         DateTime?
  spayedNeutered      Boolean    @default(false)
  allergies           String[]
  dietaryRestrictions String[]
  profilePhoto        String?
  imageUrl            String?
  ownerId             String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  documents           Document[]

  @@index([ownerId])
  @@map("pets")
}

model Document {
  id               String   @id @default(uuid())
  category         String
  hospitalName     String
  fileName         String
  originalFileName String
  filePath         String
  fileSize         Int
  mimeType         String
  date             DateTime
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  petId            String
  ownerId          String
  
  // Relations
  pet              Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model BugReport {
  id          String     @id @default(uuid())
  petOwnerId  String
  title       String
  description String
  severity    String
  category    String
  deviceInfo  String?
  appVersion  String?
  status      String     @default("pending")
  priority    String     @default("medium")
  assignedTo  String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  petOwner    PetOwner   @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([petOwnerId])
  @@index([severity])
  @@index([status])
  @@map("bug_reports")
}

model ChatMessage {
  id          String     @id
  petOwnerId  String
  message     String
  isFromUser  Boolean
  messageType String     @default("text")
  metadata    Json?
  createdAt   DateTime   @default(now())
  petOwner    PetOwner   @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([petOwnerId])
  @@map("chat_messages")
}

model UserPreference {
  id            String     @id
  petOwnerId    String     @unique
  theme         String     @default("light")
  language      String     @default("en")
  notifications Boolean    @default(true)
  biometricAuth Boolean    @default(false)
  autoBackup    Boolean    @default(true)
  settings      Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  petOwner      PetOwner   @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
