generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("MOBILE_DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  clerkUserId String    @unique
  firstName   String
  lastName    String
  email       String    @unique
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  petOwner    PetOwner?

  @@map("users")
}

model PetOwner {
  id             String          @id @default(uuid())
  clerkUserId    String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bugReports     BugReport[]
  chatMessages   ChatMessage[]
  user           User            @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Cascade)
  pets           Pet[]
  userPreference UserPreference?

  @@map("pet_owners")
}

model Pet {
  id                  String     @id @default(uuid())
  name                String
  species             String
  biologicalSex       String?
  breed               String?
  dateOfBirth         DateTime?
  weight              Float?
  spayedNeutered      Boolean    @default(false)
  allergies           String[]
  dietaryRestrictions String[]
  imageUrl            String?
  ownerId             String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  documents           Document[]
  petOwner            PetOwner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("pets")
}

model Document {
  id        String   @id @default(uuid())
  category  String
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model BugReport {
  id          String   @id @default(uuid())
  petOwnerId  String
  title       String
  severity    String
  category    String
  description String
  deviceInfo  String?
  appVersion  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  petOwner    PetOwner @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([petOwnerId])
  @@index([severity])
  @@index([status])
  @@map("bug_reports")
}

model ChatMessage {
  id          String   @id @default(uuid())
  petOwnerId  String
  message     String
  isFromUser  Boolean
  messageType String   @default("text")
  metadata    Json?
  createdAt   DateTime @default(now())
  petOwner    PetOwner @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([petOwnerId])
  @@map("chat_messages")
}

model UserPreference {
  id            String   @id @default(uuid())
  petOwnerId    String   @unique
  theme         String   @default("light")
  language      String   @default("en")
  notifications Boolean  @default(true)
  biometricAuth Boolean  @default(false)
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  petOwner      PetOwner @relation(fields: [petOwnerId], references: [id], onDelete: Cascade)

  @@index([petOwnerId])
  @@map("user_preferences")
}
