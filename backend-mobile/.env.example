# Server Configuration
PORT=3002
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://username@localhost:5432/spoodle?schema=public"

# Clerk Authentication Configuration
CLERK_SECRET_KEY=sk_test_key
CLERK_PUBLISHABLE_KEY=pk_test_key

# Email Configuration (Resend)
RESEND_API_KEY=resend_api_key

# OpenAI Configuration
OPENAI_API_KEY=open_ai_key

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# AWS S3 Configuration (for document storage)
USE_S3=true
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=spoodle-documents
