{
  "name": "verum",
  "version": "1.0.0",
  "description": "Verum — veterinary research assistant (web + Python RAG)",
  "private": true,
  "workspaces": [
    "frontend/web"
  ],
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "baseline-browser-mapping": "^2.9.14",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  }
}
